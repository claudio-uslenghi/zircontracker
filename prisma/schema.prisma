generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./placeholder.db"
}

model Resource {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  email     String?  @unique
  country   String
  color     String   @default("#4472C4")
  capacityH Int      @default(8)
  createdAt DateTime @default(now())

  // Visibility/order in the "Info para invoicing" pivot (wizard step 1).
  // null order = not yet positioned by hand, goes last (by name). Replaces
  // the old hardcoded INVOICING_RESOURCE_ORDER list in lib/invoicing-report.ts.
  invoicingHidden Boolean @default(false)
  invoicingOrder  Int?

  assignments   Assignment[]
  holidays      Holiday[]
  vacations     Vacation[]
  timeEntries   TimeEntry[]
  resourceRates ProjectResourceRate[]
  invoiceLines  InvoiceLineDef[]
}

model Project {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  color          String
  status         String
  priority       String
  startDate      DateTime
  endDate        DateTime
  estimatedHours Int
  costPerHour    Float    @default(0)
  budgetHours    Float?
  projectType    String   @default("fixed")
  notes          String   @default("")
  createdAt      DateTime @default(now())

  // Same as Resource.invoicingHidden/invoicingOrder above, for the pivot's
  // project columns. Replaces INVOICING_PROJECT_ORDER.
  invoicingHidden Boolean @default(false)
  invoicingOrder  Int?

  assignments   Assignment[]
  timeEntries   TimeEntry[]
  resourceRates ProjectResourceRate[]
  tasks         Task[]
  invoiceBlocks InvoiceBlock[]
}

model Assignment {
  id             Int      @id @default(autoincrement())
  projectId      Int
  resourceId     Int
  moduleName     String
  percentage     Int
  startDate      DateTime
  endDate        DateTime
  estimatedHours Int

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model Holiday {
  id         Int      @id @default(autoincrement())
  resourceId Int
  date       DateTime
  name       String

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, date])
}

model Vacation {
  id         Int      @id @default(autoincrement())
  resourceId Int
  startDate  DateTime
  endDate    DateTime
  notes      String   @default("")
  type       String   @default("Vacation / Day Off")
  halfDay    Boolean  @default(false)
  // Set only on vacations mirrored from the Google Sheet ("gsheet:<Timestamp>|<email>");
  // NULL = loaded by hand, which the sync never touches.
  sourceKey  String?  @unique

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model SyncRun {
  id             Int      @id @default(autoincrement())
  source         String
  trigger        String
  ranAt          DateTime @default(now())
  ok             Boolean
  created        Int      @default(0)
  updated        Int      @default(0)
  deleted        Int      @default(0)
  unchanged      Int      @default(0)
  unmatchedCount Int      @default(0)
  errorCount     Int      @default(0)
  details        String   @default("")
}

model CountryHoliday {
  id      Int      @id @default(autoincrement())
  country String
  date    DateTime
  name    String

  @@unique([country, date])
}

// Países incluidos en el envío AUTOMÁTICO del Holidays Bot (cron del día 1).
// Opt-in: un país sin fila no se manda. Nombre canónico (ver lib/countries.ts).
model HolidaysBotAutoCountry {
  country String @id
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  name      String
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())

  userRoles UserRole[]
}

model Role {
  id        Int              @id @default(autoincrement())
  name      String           @unique

  userRoles UserRole[]
  pagePerms PagePermission[]
}

model UserRole {
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model PagePermission {
  id     Int    @id @default(autoincrement())
  page   String
  roleId Int

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([page, roleId])
}

model Task {
  id        Int      @id @default(autoincrement())
  projectId Int
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  @@unique([projectId, name])
}

model TimeEntry {
  id         Int      @id @default(autoincrement())
  resourceId Int
  projectId  Int
  taskId     Int?
  date       DateTime
  hours      Float
  entryType  String   @default("regular")

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task     Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([resourceId, projectId, date, entryType, taskId])
}

model ClientInvoice {
  id          Int       @id @default(autoincrement())
  month       String
  blockId     String
  company     String    @default("Zircon")
  customer    String
  description String    @default("")
  total       Float
  billed      Float
  dateInv     DateTime
  comments    String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  payments InvoicePayment[]

  @@unique([month, blockId])
}

// One row per partial (or full) payment received against a ClientInvoice.
// Paid/Vencida/Parcial/Pendiente and Outstanding are always derived from the
// sum of these — never stored — so they can't go stale. Replaces the old
// ClientInvoice.paid/datePaid booleans (migrated into a synthetic row here,
// see scripts/add-invoice-payments.ts).
model InvoicePayment {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  amount    Float
  date      DateTime
  comment   String   @default("")
  createdAt DateTime @default(now())

  invoice ClientInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model InvoiceBlock {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  client          String
  customerName    String
  active          Boolean  @default(true)
  order           Int
  header          Boolean  @default(true)
  okMark          Boolean  @default(false)
  priceLabel      String   @default("Precio")
  qtyLabel        String   @default("Horas")
  unit            String   @default("hours")
  projectId       Int?
  paymentTermDays Int      @default(30)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items   InvoiceLineDef[]
}

model InvoiceLineDef {
  id          Int      @id @default(autoincrement())
  blockId     Int
  refSlug     String
  order       Int
  type        String
  label       String   @default("")
  rate        Float?
  rateFormula String?
  hasPerson   Boolean  @default(false)
  resourceId  Int?
  qtyDefault  Float    @default(0)
  comment     String   @default("")
  refs        String   @default("")
  factor      Float?
  qtyIsSum    Boolean  @default(false)
  avgRate     Boolean  @default(false)

  block    InvoiceBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  resource Resource?    @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@unique([blockId, refSlug])
  @@unique([blockId, order])
}

model ProjectResourceRate {
  id          Int     @id @default(autoincrement())
  projectId   Int
  resourceId  Int
  profile     String  @default("Developer")
  ratePerHour Float   @default(0)
  billable    Boolean @default(true)

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([projectId, resourceId])
}
